<?xml version="1.0" encoding="UTF-8"?>
<!--
  The module that makes the conventions executable.

  It depends on every other module because its job is to read them. Its tests
  assert the rules this repository states in prose: that dependencies point
  inward, that packages are named for what they do, and that no literal with a
  meaning sits loose in a method body.

  A rule stated only in a README is a rule nobody enforces. These fail the build
  instead.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sagecrest.standards</groupId>
    <artifactId>java-standards</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>conventions</artifactId>
  <name>Conventions</name>
  <description>The rules this repository states, as tests that fail when they are broken.</description>

  <dependencies>
    <dependency>
      <groupId>com.sagecrest.standards</groupId>
      <artifactId>domain</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sagecrest.standards</groupId>
      <artifactId>application</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sagecrest.standards</groupId>
      <artifactId>infrastructure</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sagecrest.standards</groupId>
      <artifactId>web</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
